{
  "name": "kandy",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "bin": {
    "kandy": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "node --watch --experimental-strip-types src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && chmod +x dist/cli.js && node --test"
  },
  "dependencies": {
    "@kandy/core": "workspace:*",
    "@kandy/client": "workspace:*"
  },
  "description": "A board for orchestrating coding agents. Each note is one job, run in its own git worktree.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "codex",
    "git-worktree",
    "kanban",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiteshbandhu/kandy.git"
  },
  "homepage": "https://github.com/hiteshbandhu/kandy#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}